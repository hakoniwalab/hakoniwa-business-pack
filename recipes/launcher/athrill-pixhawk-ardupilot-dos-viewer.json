{
  "version": "0.1",
  "runtime": { "cleanup_mmap_on_start": false },
  "defaults": {
    "env": {
      "prepend": {
        "lib_path": ["${HAKO_FOUNDATION_INSTALL}/lib"]
      }
    },
    "stdout": "${HAKO_RECIPE_WORKSPACE}/logs/${asset}.out",
    "stderr": "${HAKO_RECIPE_WORKSPACE}/logs/${asset}.err",
    "delay_sec": 2
  },
  "assets": [
    {
      "name": "athrill",
      "activation_timing": "before_start",
      "command": "${ATHRILL_TARGET_ROOT}/examples/ardupilot-hakoniwa/run.sh",
      "args": [
        "${ARDUPILOT_ELF}",
        "${ATHRILL_TARGET_ROOT}/build-hakoniwa/athrill3",
        "${ATHRILL_DEVICE_ROOT}/build-stm32-inproc/libhako_sensor_device_inproc_motor.dylib",
        "${HAKO_RECIPE_REPOSITORY}/recipes/config/athrill-pixhawk/ardupilot-dos.txt"
      ],
      "cwd": "${ATHRILL_TARGET_ROOT}/examples/ardupilot-hakoniwa",
      "env": {
        "set": {
          "ATHRILL_DEVICE_DIR": "${ATHRILL_DEVICE_ROOT}",
          "ATHRILL_WORK_DIR": "${HAKO_RECIPE_WORKSPACE}/state",
          "PYTHON": "${HAKO_FOUNDATION_PYTHON}",
          "HAKO_DRONE_ROOT": "${HAKO_DRONE_ROOT}",
          "HAKO_AIRCRAFT_CONFIG_PATH": "${ATHRILL_TARGET_ROOT}/examples/ardupilot-hakoniwa/x500-athrill-ardupilot",
          "ATHRILL_OPTIONS": "--hakoniwa athrill --pdudef ${HAKO_BRIDGE_ROOT}/config/web_bridge_disturb/pdu/drone-disturb-visual-state.json"
        }
      },
      "delay_sec": 5
    },
    {
      "name": "web_bridge",
      "activation_timing": "before_start",
      "depends_on": ["athrill"],
      "command": "${HAKO_FOUNDATION_INSTALL}/bin/hakoniwa-pdu-web-bridge",
      "args": [
        "--config-root", "config/web_bridge_disturb",
        "--node-name", "web_bridge_disturb_node1",
        "--delta-time-step-usec", "20000",
        "--enable-ondemand"
      ],
      "cwd": "${HAKO_BRIDGE_ROOT}",
      "delay_sec": 2
    },
    {
      "name": "viewer",
      "activation_timing": "after_start",
      "command": "${HAKO_FOUNDATION_PYTHON}",
      "args": ["tools/hako.py", "serve", "--port", "8000"],
      "cwd": "${HAKO_THREEJS_ROOT}",
      "delay_sec": 1
    }
  ]
}
